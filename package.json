{
  "name": "wmux-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "prestart": "npm run build:host",
    "start": "expo start --dev-client",
    "preandroid": "npm run build:host",
    "android": "expo run:android",
    "preios": "npm run build:host",
    "ios": "expo run:ios",
    "eas-build-post-install": "npm run build:host",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:host": "vite build --config src/terminal/host/vite.config.mts",
    "test:unit": "tsx --test test/*.test.mjs test/*.test.ts",
    "test:host": "playwright test --config e2e/playwright.host.config.ts",
    "test": "npm run test:unit && npm run test:host",
    "sync:protocol": "node scripts/sync-protocol.mjs",
    "sync:ghostty": "node scripts/sync-ghostty.mjs",
    "sync:terminal-sources": "node scripts/sync-terminal-sources.mjs",
    "check:protocol": "node scripts/sync-protocol.mjs --check",
    "check:ghostty": "node scripts/sync-ghostty.mjs --check",
    "check:terminal-sources": "node scripts/sync-terminal-sources.mjs --check",
    "check:host-asset": "node scripts/check-terminal-host.mjs",
    "check:expo": "expo config --type public",
    "check": "npm run check:protocol && npm run check:ghostty && npm run check:terminal-sources && npm run lint && npm run format:check && npm run typecheck && npm run build:host && npm run check:host-asset && npm test && npm run check:expo"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "expo": "~57.0.8",
    "expo-asset": "~57.0.7",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.7",
    "expo-dev-client": "~57.0.7",
    "expo-file-system": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "ghostty-web": "file:src/terminal/host/vendor/ghostty-web.tgz",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@playwright/browser-chromium": "^1.60.0",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "vite": "^7.2.7",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "overrides": {
    "eslint-import-resolver-typescript": "^4.4.5"
  }
}
